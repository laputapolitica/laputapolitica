{"updatedAt":"2026-06-10T04:27:00.041Z","createdAt":"2026-06-10T00:29:15.371Z","id":"JfaILkRkUvfHjke0","name":"Relevamiento","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{},"type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[0,0],"id":"3c7e5b64-e104-425b-86c2-2cd780d62e0a","name":"When clicking ‘Execute workflow’"},{"parameters":{"tableId":"ediciones","fieldsUi":{"fieldValues":[{"fieldId":"fecha","fieldValue":"01-01-2030"},{"fieldId":"titulo","fieldValue":"Edición de prueba"},{"fieldId":"estado","fieldValue":"in_progress"},{"fieldId":"pais","fieldValue":"AR"}]}},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[208,0],"id":"e6da3579-c0fc-46a6-b464-c1072e4f15c8","name":"Create a row","credentials":{"supabaseApi":{"id":"ILcX2krUhMs1jKhe","name":"Supabase account"}}},{"parameters":{"tableId":"pipeline_state","fieldsUi":{"fieldValues":[{"fieldId":"relevamiento_status","fieldValue":"running"},{"fieldId":"edicion_id","fieldValue":"={{ $json.id }}"}]}},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[416,0],"id":"5f7cd269-7f16-43a4-8f4d-458ee9998900","name":"Create a row1","credentials":{"supabaseApi":{"id":"ILcX2krUhMs1jKhe","name":"Supabase account"}}},{"parameters":{"url":"https://www.infobae.com/arc/outboundfeeds/rss/category/politica/?outputType=xml","options":{}},"type":"n8n-nodes-base.rssFeedRead","typeVersion":1.2,"position":[624,0],"id":"add3f7fe-e910-401c-9bdd-43e465f1ad6f","name":"RSS Read"},{"parameters":{"jsCode":"// Toma todos los items del RSS y arma una lista numerada de títulos + link.\nconst items = $input.all();\n\nconst lista = items\n  .map((item, i) => `${i + 1}. ${item.json.title} | ${item.json.link}`)\n  .join(\"\\n\");\n\nreturn [\n  {\n    json: {\n      cantidad: items.length,\n      lista_titulares: lista,\n    },\n  },\n];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[832,0],"id":"4668b469-91eb-4361-9116-52c79addce57","name":"Code in JavaScript"},{"parameters":{"modelId":{"__rl":true,"value":"models/gemini-2.5-flash","mode":"list","cachedResultName":"models/gemini-2.5-flash"},"messages":{"values":[{"content":"=Sos el editor de relevamiento de un medio de noticias políticas argentino para público joven. Te paso una lista de titulares de noticias del día con su link.\n\nTu tarea:\n1. Seleccioná SOLO las noticias de política argentina relevantes (descartá deportes, espectáculos, policiales menores, internacionales sin impacto local, y notas de color).\n2. Ordená las seleccionadas en un ranking por importancia política (la más importante primero).\n3. Devolvé entre 8 y 12 noticias.\n\nDevolvé EXCLUSIVAMENTE un array JSON válido, sin texto antes ni después, sin markdown, con este formato exacto:\n[\n  {\"ranking\": 1, \"titulo\": \"el titular tal cual\", \"fuente_url\": \"el link\"},\n  {\"ranking\": 2, \"titulo\": \"...\", \"fuente_url\": \"...\"}\n]\n\nLista de titulares del día:\n{{ $json.lista_titulares }}"}]},"jsonOutput":true,"builtInTools":{},"options":{}},"type":"@n8n/n8n-nodes-langchain.googleGemini","typeVersion":1.2,"position":[1040,0],"id":"2995644c-1586-419a-b72e-cb8d7d56794e","name":"Message a model","retryOnFail":true,"waitBetweenTries":5000,"credentials":{"googlePalmApi":{"id":"c3x0tWH5DnDP4Xia","name":"Google Gemini(PaLM) Api account"}}},{"parameters":{"jsCode":"// Toma la respuesta de Gemini, extrae el texto, lo limpia y lo parsea a JSON.\nconst raw = $input.first().json;\n\n// El texto puede venir en distintas rutas según cómo devuelva Gemini.\nlet texto =\n  raw?.content?.parts?.[0]?.text ??\n  raw?.text ??\n  raw?.message?.content ??\n  \"\";\n\n// Por las dudas, sacar posibles cercos de markdown (```json ... ```).\ntexto = texto.trim().replace(/^```json/i, \"\").replace(/^```/, \"\").replace(/```$/, \"\").trim();\n\n// Parsear el texto a un array de objetos.\nlet candidatas;\ntry {\n  candidatas = JSON.parse(texto);\n} catch (e) {\n  throw new Error(\"No se pudo parsear el JSON de Gemini. Texto recibido: \" + texto.slice(0, 300));\n}\n\n// Devolver cada candidata como un item separado.\nreturn candidatas.map((c) => ({ json: c }));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1392,0],"id":"e79fdec0-1477-4b8a-87e0-61f44884ff63","name":"Code in JavaScript1"},{"parameters":{"tableId":"relevamiento_candidatas","fieldsUi":{"fieldValues":[{"fieldId":"edicion_id","fieldValue":"={{ $('Create a row').item.json.id }}"},{"fieldId":"titulo","fieldValue":"={{ $json.titulo }}"},{"fieldId":"ranking","fieldValue":"={{ $json.ranking }}"},{"fieldId":"fuente_url","fieldValue":"={{ $json.fuente_url }}"}]}},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[1600,0],"id":"db04f963-8bd9-4848-b71b-3da7c857fa2f","name":"Create a row2","credentials":{"supabaseApi":{"id":"ILcX2krUhMs1jKhe","name":"Supabase account"}}},{"parameters":{"jsCode":"// Colapsa todos los items a uno solo, recuperando el edicion_id de la edición creada al inicio.\nconst edicionId = $('Create a row').first().json.id;\n\nreturn [\n  {\n    json: {\n      edicion_id: edicionId,\n    },\n  },\n];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1808,0],"id":"0775e355-d333-41e9-bf11-bfd30792040c","name":"Code in JavaScript2"},{"parameters":{"operation":"update","tableId":"pipeline_state","filters":{"conditions":[{"keyName":"edicion_id","condition":"eq","keyValue":"={{ $json.edicion_id }}"}]},"fieldsUi":{"fieldValues":[{"fieldId":"relevamiento_status","fieldValue":"done"}]}},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[2016,0],"id":"19a5f546-1602-4a85-8d5b-6286f879492f","name":"Update a row","credentials":{"supabaseApi":{"id":"ILcX2krUhMs1jKhe","name":"Supabase account"}}}],"connections":{"When clicking ‘Execute workflow’":{"main":[[{"node":"Create a row","type":"main","index":0}]]},"Create a row":{"main":[[{"node":"Create a row1","type":"main","index":0}]]},"Create a row1":{"main":[[{"node":"RSS Read","type":"main","index":0}]]},"RSS Read":{"main":[[{"node":"Code in JavaScript",