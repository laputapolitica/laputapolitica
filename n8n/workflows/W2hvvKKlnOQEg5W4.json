{"updatedAt":"2026-08-05T05:43:31.855Z","createdAt":"2026-08-05T05:42:59.313Z","id":"W2hvvKKlnOQEg5W4","name":"Relevamiento","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"0 19 * * *"}]}},"name":"Schedule Trigger","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.3,"position":[0,0],"id":"29a5110c-3b29-4d92-88e5-91618b7c3f59"},{"parameters":{"operation":"getAll","tableId":"paises","returnAll":true,"filters":{"conditions":[{"keyName":"codigo","condition":"eq","keyValue":"AR"},{"keyName":"pipeline_activo","condition":"eq","keyValue":"true"}]}},"name":"Get paises","type":"n8n-nodes-base.supabase","typeVersion":1,"position":[208,0],"id":"5e1975c8-7b47-4ab4-8d48-af66eecc1325","credentials":{"supabaseApi":{"id":"ILcX2krUhMs1jKhe","name":"Supabase account"}}},{"parameters":{"tableId":"ediciones","fieldsUi":{"fieldValues":[{"fieldId":"fecha","fieldValue":"={{ $now.setZone('America/Argentina/Buenos_Aires').toFormat('dd-MM-yyyy') }}"},{"fieldId":"titulo","fieldValue":"Sin título"},{"fieldId":"estado","fieldValue":"in_progress"},{"fieldId":"pais","fieldValue":"AR"}]}},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[416,0],"id":"c8a12874-709a-440a-981b-889ba1da5d72","name":"Create a row","credentials":{"supabaseApi":{"id":"ILcX2krUhMs1jKhe","name":"Supabase account"}}},{"parameters":{"tableId":"pipeline_state","fieldsUi":{"fieldValues":[{"fieldId":"relevamiento_status","fieldValue":"running"},{"fieldId":"edicion_id","fieldValue":"={{ $json.id }}"}]}},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[624,0],"id":"b10d952d-c9e7-4176-bc69-b1d114a224f8","name":"Create a row1","credentials":{"supabaseApi":{"id":"ILcX2krUhMs1jKhe","name":"Supabase account"}}},{"parameters":{"url":"https://www.infobae.com/arc/outboundfeeds/rss/category/politica/?outputType=xml","options":{}},"type":"n8n-nodes-base.rssFeedRead","typeVersion":1.2,"position":[832,0],"id":"172d810f-8da2-4904-9964-c051054ea839","name":"RSS Read"},{"parameters":{"jsCode":"// Toma todos los items del RSS y arma una lista numerada de títulos + link.\nconst items = $input.all();\n\nconst lista = items\n  .map((item, i) => `${i + 1}. ${item.json.title} | ${item.json.link}`)\n  .join(\"\\n\");\n\nreturn [\n  {\n    json: {\n      cantidad: items.length,\n      lista_titulares: lista,\n    },\n  },\n];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1040,0],"id":"b3f3a5ba-ca9c-4c8b-ba95-7df5253928de","name":"Code in JavaScript"},{"parameters":{"modelId":{"__rl":true,"value":"models/gemini-2.5-flash","mode":"list","cachedResultName":"models/gemini-2.5-flash"},"messages":{"values":[{"content":"=Sos el editor de relevamiento de un medio de noticias políticas argentino para público joven. Te paso una lista de titulares de noticias del día con su link.\n\nTu tarea:\n1. Seleccioná SOLO las noticias de política argentina relevantes (descartá deportes, espectáculos, policiales menores, internacionales sin impacto local, y notas de color).\n2. Ordená las seleccionadas en un ranking por importancia política (la más importante primero).\n3. Devolvé entre 8 y 12 noticias.\n\nDevolvé EXCLUSIVAMENTE un array JSON válido, sin texto antes ni después, sin markdown, con este formato exacto:\n[\n  {\"ranking\": 1, \"titulo\": \"el titular tal cual\", \"fuente_url\": \"el link\"},\n  {\"ranking\": 2, \"titulo\": \"...\", \"fuente_url\": \"...\"}\n]\n\nLista de titulares del día:\n{{ $json.lista_titulares }}"}]},"jsonOutput":true,"builtInTools":{},"options":{}},"type":"@n8n/n8n-nodes-langchain.googleGemini","typeVersion":1.2,"position":[1248,0],"id":"d2226603-54c4-4261-84a5-933bf2cf2420","name":"Message a model","retryOnFail":true,"waitBetweenTries":5000,"credentials":{"googlePalmApi":{"id":"c3x0tWH5DnDP4Xia","name":"Google Gemini(PaLM) Api account"}}},{"parameters":{"jsCode":"// Toma la respuesta de Gemini, extrae el texto, lo limpia y lo parsea a JSON.\nconst raw = $input.first().json;\n\n// El texto puede venir en distintas rutas según cómo devuelva Gemini.\nlet texto =\n  raw?.content?.parts?.[0]?.text ??\n  raw?.text ??\n  raw?.message?.content ??\n  \"\";\n\n// Por las dudas, sacar posibles cercos de markdown (```json ... ```).\ntexto = texto.trim().replace(/^```json/i, \"\").replace(/^```/, \"\").replace(/```$/, \"\").trim();\n\n// Parsear el texto a un array de objetos.\nlet candidatas;\ntry {\n  candidatas = JSON.parse(texto);\n} catch (e) {\n  throw new Error(\"No se pudo parsear el JSON de Gemini. Texto recibido: \" + texto.slice(0, 300));\n}\n\n// Devolver cada candidata como un item separado.\nreturn candidatas.map((c) => ({ json: c }));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1600,0],"id":"76b78036-d966-4f63-b52d-4e6e0fb7e53c","name":"Code in JavaScript1"},{"parameters":{"tableId":"relevamiento_candidatas","fieldsUi":{"fieldValues":[{"fieldId":"edicion_id","fieldValue":"={{ $('Create a row').item.json.id }}"},{"fieldId":"titulo","fieldValue":"={{ $json.titulo }}"},{"fieldId":"ranking","fieldValue":"={{ $json.ranking }}"},{"fieldId":"fuente_url","fieldValue":"={{ $json.fuente_url }}"},{"fieldId":"activa","fieldValue":"={{ $json.ranking <= 5 }}"},{"fieldId":"orden","fieldValue":"={{ $json.ranking <= 5 ? $json.ranking : null }}"}]}},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[1808,0],"id":"aea32958-b792-4d62-9c53-406e3ba0657f","name":"Create a row2","credentials":{"supabaseApi":{"id":"ILcX2krUhMs1jKhe","name":"Supabase account"}}},{"parameters":{"jsCode":"// Colapsa todos los items a uno solo, recuperando el edicion_id de la edición creada al inicio.\nconst edicionId = $('Create a row').first().json.id;\n\nreturn [\n  {\n    json: {\n      edicion_id: edicionId,\n    },\n  },\n];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2016,0],"id":"c5da9c97-4858-488f-9a41-09bb960e71a3","name":"Code in JavaScript2"},{"parameters":{"operation":"update","tableId":"pipeline_state","filters":{"conditions":[{"keyName":"edicion_id","condition":"eq","keyValue":"={{ $json.edicion_id }}"}]},"fieldsUi":{"fieldValues":[{"fieldId":"relevamiento_status","fieldValue":"done"}]}},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[2224,0],"id":"1a4dd405-add3-4a35-9879-a616573e12ea","name":"Update a row","credentials":{"supabaseApi":{"id":"ILcX2krUhMs1jKhe","name":"Supabase account"}}}],"connections":{"Create a row":{"main":[[{"node":"Create a row1","type":"main","index":0}]]},"Create a row1":{"main":[[{"node":"RSS Read","type":"main","index":0}]]},"RSS Read":{"main":[[{"node":"Code in JavaScript","type":"main","index":0}]]},"Code in JavaScript":{"main":[[{"node":"Message a model","type":"main","index":0}]]},"Message a model":{"main":[[{"node":"Code in JavaScript1","type":"main","index":0}]]},"Code in JavaScript1":{"main":[[{"node":"Create a row2","type":"main","index":0}]]},"Create a row2":{"main":[[{"node":"Code in JavaScript2","type":"main","index":0}]]},"Code in JavaScript2":{"main":[[{"node":"Update a row","type":"main","index":0}]]},"Schedule Trigger":{"main":[[{"node":"Get paises","type":"main","index":0}]]},"Get paises":{"main":[[{"node":"Create a row","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","binaryMode":"separate","availableInMCP":false},"staticData":null,"meta":null,"nodeGroups":[],"pinData":{},"versionId":"2212c318-e6e7-4771-ae0a-4a96716d8bed","activeVersionId":null,"versionCounter":1,"triggerCount":0,"sourceWorkflowId":null,"tags":[],"shared":[{"updatedAt":"2026-08-05T05:42:59.317Z","createdAt":"2026-08-05T05:42:59.317Z","role":"workflow:owner","workflowId":"W2hvvKKlnOQEg5W4","projectId":"Mv3m9K1Rw8oQGK32","project":{"updatedAt":"2026-06-09T08:31:59.888Z","createdAt":"2026-06-09T08:29:52.978Z","id":"Mv3m9K1Rw8oQGK32","name":"La Puta Politica <laputapolitica@outlook.com>","type":"personal","icon":null,"description":null,"customTelemetryTags":[],"creatorId":"87cece7a-5a02-4a25-8577-94834d9a6078"}}],"versionMetadata":{"name":null,"de