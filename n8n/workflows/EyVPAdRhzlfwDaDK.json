{"updatedAt":"2026-06-22T10:59:46.592Z","createdAt":"2026-06-22T10:59:46.592Z","id":"EyVPAdRhzlfwDaDK","name":"X (Twitter)","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":1}]}},"type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.3,"position":[0,0],"id":"d4a82504-a7a8-42c5-8744-feef19e879d5","name":"Schedule Trigger"},{"parameters":{"operation":"getAll","tableId":"pipeline_state","returnAll":true,"filters":{"conditions":[{"keyName":"twitter_status","condition":"eq","keyValue":"pending"}]}},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[224,0],"id":"48102608-4365-4ac3-af0e-ad685ba90058","name":"Get many rows","credentials":{"supabaseApi":{"id":"ILcX2krUhMs1jKhe","name":"Supabase account"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"360e50d4-2c52-4082-8a93-3d093ae19bc7","leftValue":"={{ $json.el_pulso_aprobado_en }}","rightValue":"","operator":{"type":"string","operation":"notEmpty","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.filter","typeVersion":2.3,"position":[448,0],"id":"7b8c9808-9bb7-4046-b774-7bf15af4dce9","name":"Filter"},{"parameters":{"operation":"update","tableId":"pipeline_state","filters":{"conditions":[{"keyName":"edicion_id","condition":"eq","keyValue":"={{ $json.edicion_id }}"}]},"fieldsUi":{"fieldValues":[{"fieldId":"twitter_status","fieldValue":"running"}]}},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[672,0],"id":"fbd70ef4-ae9e-49f4-8d49-e1d98fe91ae7","name":"Update a row","credentials":{"supabaseApi":{"id":"ILcX2krUhMs1jKhe","name":"Supabase account"}}},{"parameters":{"url":"https://eapsfpjahdbjypvxvutt.supabase.co/rest/v1/ediciones","authentication":"genericCredentialType","genericAuthType":"httpCustomAuth","sendQuery":true,"queryParameters":{"parameters":[{"name":"id","value":"=eq.{{ $('Update a row').first().json.edicion_id }}"},{"name":"select","value":"titulo,fecha,portada_url,noticias(orden,titulo,cuerpo,el_pulso_noticia(texto_resumen,pct_positiva,pct_negativa,pct_incierta))"},{"name":"noticias.order","value":"orden"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[880,0],"id":"2586695e-e3f8-4b7a-bdea-bad9d46c1bdc","name":"Get fuente","credentials":{"httpCustomAuth":{"id":"pXtepqswCObIVKqd","name":"Supabase Service Role"}}},{"parameters":{"url":"https://eapsfpjahdbjypvxvutt.supabase.co/rest/v1/portadas","authentication":"genericCredentialType","genericAuthType":"httpCustomAuth","sendQuery":true,"queryParameters":{"parameters":[{"name":"edicion_id","value":"=eq.{{ $('Update a row').first().json.edicion_id }}"},{"name":"vigente","value":"eq.true"},{"name":"select","value":"imagen_url"},{"name":"limit","value":"1"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[1104,0],"id":"d845b60b-f0b5-4cc6-83f3-e6d524e9b924","name":"Get portada","credentials":{"httpCustomAuth":{"id":"pXtepqswCObIVKqd","name":"Supabase Service Role"}}},{"parameters":{"jsCode":"\nconst edicionId = $('Update a row').first().json.edicion_id;\nlet fuente = $('Get fuente').first().json;\nif (Array.isArray(fuente)) fuente = fuente[0];\nlet portada = $('Get portada').first().json;\nif (Array.isArray(portada)) portada = portada[0];\nconst portadaUrl = (portada && portada.imagen_url) ? portada.imagen_url\n  : (fuente && fuente.portada_url) ? fuente.portada_url : null;\n\nconst tituloEdicion = (fuente && fuente.titulo) ? fuente.titulo : \"\";\nconst fechaSlug = (fuente && fuente.fecha) ? fuente.fecha : \"\";\n\nfunction pulsoOf(n){\n  const p = Array.isArray(n.el_pulso_noticia) ? n.el_pulso_noticia[0] : n.el_pulso_noticia;\n  return { texto:(p&&p.texto_resumen)||\"\", pos:(p&&p.pct_positiva)||0, neg:(p&&p.pct_negativa)||0, inc:(p&&p.pct_incierta)||0 };\n}\nconst noticias = ((fuente && fuente.noticias) || []).slice().sort((a,b)=>a.orden-b.orden).slice(0,5)\n  .map(n => { const p = pulsoOf(n); return { titulo:n.titulo, cuerpo:n.cuerpo||\"\", pulso:p.texto, pos:p.pos, neg:p.neg, inc:p.inc }; });\n\nconst lineas = noticias.map((n,i)=>(\n  \"NOTICIA \" + (i+1) + \":\\nTítulo: \" + n.titulo + \"\\nResumen: \" + n.cuerpo + \"\\nLectura comunidad (El Pulso): \" + n.pulso\n)).join(\"\\n\\n\");\n\nconst prompt = [\n \"Sos editor de La Puta Política (medio político argentino para jóvenes) escribiendo un hilo para Twitter/X.\",\n \"Para CADA noticia generá dos textos cortos, con voz directa y gancho pero seria, sin hashtags, sin comillas, sin emojis:\",\n \"- titular: un titular propio de Twitter, máximo 120 caracteres.\",\n \"- pulso: UNA línea que sintetice qué pensó la comunidad, máximo 120 caracteres.\",\n \"\",\n \"Noticias (en orden):\",\n lineas,\n \"\",\n 'Devolvé SOLO un JSON con esta forma exacta, en el MISMO orden de las noticias:',\n '{\"items\":[{\"titular\":\"...\",\"pulso\":\"...\"}, ...]}'\n].join(\"\\n\");\n\nreturn [{ json: {\n  edicion_id: edicionId,\n  titulo_edicion: tituloEdicion,\n  fecha: fechaSlug,\n  portada_url: portadaUrl,\n  noticias,\n  groq_prompt: prompt\n}}];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1328,0],"id":"17c8fbf3-6a32-4dc1-bb2d-80b2b8777e60","name":"Preparar fuente"},{"parameters":{"method":"POST","url":"https://api.groq.com/openai/v1/chat/completions","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    { \"role\": \"user\", \"content\": {{ JSON.stringify($json.groq_prompt) }} }\n  ]\n}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[1552,0],"id":"cdd88a2d-8f9a-4a94-b714-e9fbaf4dd1b6","name":"Groq","credentials":{"httpHeaderAuth":{"id":"53267AutPZ1iGYA1","name":"Header Auth account"}}},{"parameters":{"jsCode":"\nconst src = $('Preparar fuente').first().json;\nlet content = \"\";\ntry { content = $json.choices[0].message.content; } catch (e) { content = \"\"; }\nlet parsed = {};\ntry { parsed = JSON.parse(content); } catch (e) { parsed = {}; }\nconst items = Array.isArray(parsed.items) ? parsed.items : [];\n\nconst fecha = src.fecha;\nconst hilos = [];\n\n// Hilo 1: tapa\nhilos.push({\n  orden: 1,\n  texto: src.titulo_edicion,\n  imagen_url: src.portada_url,\n  payload: { tipo:\"tapa\", titulo_edicion: src.titulo_edicion, fecha }\n});\n\n// Hilos 2..N: una por noticia (titular + pulso + barra de votos)\nconst noticias = src.noticias || [];\nnoticias.forEach((n, i) => {\n  const it = items[i] || {};\n  const titular = (it.titular || n.titulo || \"\").trim();\n  const pulsoLinea = (it.pulso || \"\").trim();\n  const barra = \"🟢 \" + n.pos + \"% 🔴 \" + n.neg + \"% 🟣 \" + n.inc + \"%\";\n  const texto = [titular, pulsoLinea, barra].filter(Boolean).join(\"\\n\");\n  hilos.push({\n    orden: i + 2,\n    texto,\n    imagen_url: null,\n    payload: {\n      tipo:\"noticia\", orden_noticia: i+1, titular, pulso: pulsoLinea,\n      votos: { positiva:n.pos, negativa:n.neg, incierta:n.inc },\n      chars: texto.length, over_280: texto.length > 280, fecha\n    }\n  });\n});\n\n// Hilo final: cierre fijo\nhilos.push({\n  orden: hilos.length + 1,\n  texto: \"La edición completa en laputapolitica.com\",\n  imagen_url: null,\n  payload: { tipo:\"cierre\", fecha }\n});\n\nreturn [{ json: { edicion_id: src.edicion_id, hilos } }];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1760,0],"id":"1b6df876-5b18-401f-ada0-23498b3a939c","name":"Armar hilos"},{"parameters":{"method":"DELETE","url":"={{ 'https://eapsfpjahdbjypvxvutt.supabase.co/rest/v1/publicacion_twitter?edicion_id=eq.' + $('Update a row').first().json.edicion_id }}","authentication":"genericCredentialType","genericAuthType":"httpCustomAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Prefer","value":"return=minim