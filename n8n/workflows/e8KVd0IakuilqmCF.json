ypvxvutt.supabase.co/rest/v1/rpc/calcular_pulso_edicion","authentication":"genericCredentialType","genericAuthType":"httpCustomAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"p_edicion_id\": \"{{ $('Update a row').first().json.edicion_id }}\"\n}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[832,0],"id":"c7d3abb9-c64c-44f3-970c-40de8ca85c72","name":"HTTP Request","credentials":{"httpCustomAuth":{"id":"pXtepqswCObIVKqd","name":"Supabase Service Role"}}},{"parameters":{"operation":"getAll","tableId":"noticias","returnAll":true,"filters":{"conditions":[{"keyName":"edicion_id","condition":"eq","keyValue":"={{ $('Update a row').first().json.edicion_id }}"}]}},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[1040,0],"id":"324c6207-8a6b-4f45-af6f-66f896f8ca77","name":"Get many rows1","credentials":{"supabaseApi":{"id":"ILcX2krUhMs1jKhe","name":"Supabase account"}}},{"parameters":{"operation":"getAll","tableId":"opiniones","returnAll":true,"filters":{"conditions":[{"keyName":"noticia_id","condition":"eq","keyValue":"={{ $json.id }}"}]}},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[1248,0],"id":"f18354a7-a9f7-47ba-a73c-4d418359d680","name":"Get many rows2","credentials":{"supabaseApi":{"id":"ILcX2krUhMs1jKhe","name":"Supabase account"}}},{"parameters":{"jsCode":"// Agrupa todas las opiniones por noticia_id y arma el texto consolidado por noticia.\nconst todas = $input.all().map((o) => o.json);\n\n// Agrupar por noticia_id.\nconst porNoticia = {};\nfor (const op of todas) {\n  if (!porNoticia[op.noticia_id]) {\n    porNoticia[op.noticia_id] = [];\n  }\n  porNoticia[op.noticia_id].push(op);\n}\n\n// Un ítem de salida por noticia, con su texto consolidado.\nconst salida = Object.entries(porNoticia).map(([noticiaId, opiniones]) => {\n  const textoOpiniones = opiniones\n    .map((o, i) => `Opinión ${i + 1} (voto: ${o.sentiment}): ${o.texto}`)\n    .join(\"\\n\\n\");\n\n  return {\n    json: {\n      noticia_id: noticiaId,\n      total: opiniones.length,\n      texto_opiniones: textoOpiniones,\n    },\n  };\n});\n\nreturn salida;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1456,0],"id":"7c1ff385-86ae-4e9c-af8f-b6c448d07221","name":"Code in JavaScript"},{"parameters":{"method":"POST","url":"https://api.groq.com/openai/v1/chat/completions","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify(\"Sos analista de un medio político argentino. A continuación tenés las opiniones que dejó una comunidad de lectores jóvenes sobre una noticia del día, cada una con su voto (positiva, negativa o incierta). Tu tarea es escribir un RESUMEN BREVE (2 a 4 oraciones) que sintetice qué pensó la comunidad: las posturas principales, y si hubo acuerdo o división. Tono neutral y descriptivo, fiel a lo que se opinó. No inventes posturas que no estén. No uses comillas.\\n\\nOpiniones de la comunidad:\\n\" + $json.texto_opiniones + \"\\n\\nDevolvé SOLAMENTE un objeto JSON con la forma {\\\"resumen\\\": \\\"...\\\"} y nada más.\") }}\n    }\n  ]\n}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[1664,0],"id":"a23e9c76-9ca8-443a-ab60-1b004f0df483","name":"HTTP Request1","credentials":{"httpHeaderAuth":{"id":"53267AutPZ1iGYA1","name":"Header Auth account"}}},{"parameters":{"jsCode":"// Procesa los 5 ítems (uno por noticia): extrae el resumen del Groq\n// y lo une con su noticia_id (del nodo que agrupó).\nconst items = $input.all();\nconst agrupados = $('Code in JavaScript').all();\n\nconst salida = items.map((item, index) => {\n  const groqContent = item.json.choices[0].message.content;\n\n  let resumen = \"\";\n  try {\n    resumen = JSON.parse(groqContent).resumen ?? \"\";\n  } catch (e) {\n    resumen = \"\";\n  }\n\n  // El noticia_id del mismo índice (el Groq mantiene el orden de los ítems).\n  const noticiaId = agrupados[index]?.json?.noticia_id ?? \"\";\n\n  return {\n    json: {\n      noticia_id: noticiaId,\n      texto_resumen: resumen,\n    },\n  };\n});\n\nreturn salida;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1872,0],"id":"6da120a8-b560-4cd2-99c1-5938084b1133","name":"Code in JavaScript1"},{"parameters":{"operation":"update","tableId":"el_pulso_noticia","filters":{"conditions":[{"keyName":"noticia_id","condition":"eq","keyValue":"={{ $json.noticia_id }}"}]},"fieldsUi":{"fieldValues":[{"fieldId":"texto_resumen","fieldValue":"={{ $json.texto_resumen }}"}]}},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[2080,0],"id":"b52c33f7-3304-4f31-9fb8-8a9687c37ed6","name":"Update a row1","credentials":{"supabaseApi":{"id":"ILcX2krUhMs1jKhe","name":"Supabase account"}}},{"parameters":{"operation":"update","tableId":"pipeline_state","filters":{"conditions":[{"keyName":"edicion_id","condition":"eq","keyValue":"={{ $('Update a row').first().json.edicion_id }}"}]},"fieldsUi":{"fieldValues":[{"fieldId":"el_pulso_status","fieldValue":"done"}]}},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[2288,0],"id":"75b2e7ea-af1c-41da-9717-33c6e9b95b26","name":"Update a row2","credentials":{"supabaseApi":{"id":"ILcX2krUhMs1jKhe","name":"Supabase account"}}}],"connections":{"Schedule Trigger":{"main":[[{"node":"Get many rows","type":"main","index":0}]]},"Get many rows":{"main":[[{"node":"Filter","type":"main","index":0}]]},"Filter":{"main":[[{"node":"Update a row","type":"main","index":0}]]},"Update a row":{"main":[[{"node":"HTTP Request","type":"main","index":0}]]},"HTTP Request":{"main":[[{"node":"Get many rows1","type":"main","index":0}]]},"Get many rows1":{"main":[[{"node":"Get many rows2","type":"main","index":0}]]},